assert(defined(gnb_build_dir))

declare_args() {
  gnb_pkgs_dir = rebase_path("${gnb_build_dir}/../packages")
}

declare_args() {
  gnb_which = rebase_path("${gnb_build_dir}/scripts/which.py")
  gnb_pkgload = rebase_path("${gnb_build_dir}/scripts/pkgload.py")
  gnb_pkgexec = rebase_path("${gnb_build_dir}/scripts/pkgexec.py")
  gnb_pkgcopy = rebase_path("${gnb_build_dir}/scripts/pkgcopy.py")
}

template("pkgdeps") {
  not_needed(invoker, "*")

  group(target_name) {
    pkgpath = exec_script(gnb_pkgload,
                          [
                            target_name,
                            "--pkgs_dir",
                            gnb_pkgs_dir,
                            "--groupath",
                          ],
                          "string")

    public_deps = []
    if (defined(invoker.deps)) {
      foreach(dep, invoker.deps) {
        public_deps += [ "${pkgpath}/:${dep}" ]
      }
    } else {
      public_deps += [ "${pkgpath}/:default" ]
    }
  }
}

template("pkgcfgs") {
  not_needed(invoker, "*")

  config(target_name) {
    pkgpath = exec_script(gnb_pkgload,
                          [
                            target_name,
                            "--pkgs_dir",
                            gnb_pkgs_dir,
                            "--groupath",
                          ],
                          "string")

    configs = []
    if (defined(invoker.configs)) {
      foreach(cfg, invoker.configs) {
        configs += [ "${pkgpath}/:${cfg}" ]
      }
    } else {
      configs += [ "${pkgpath}/:public" ]
    }
  }
}
