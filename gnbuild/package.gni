assert(defined(gnb_repo_dir))

declare_args() {
  gnb_which = rebase_path("${gnb_repo_dir}/scripts/which.py")
  gnb_pkgexec = rebase_path("${gnb_repo_dir}/scripts/pkgexec.py")
  gnb_pkgcopy = rebase_path("${gnb_repo_dir}/scripts/pkgcopy.py")
  gnb_pkgload = rebase_path("${gnb_repo_dir}/scripts/pkgload.py")

  gnb_pkgs_dir = rebase_path("${gnb_repo_dir}/packages")
}

template("pkggroup") {
  not_needed(invoker, "*")

  group(target_name) {
    pkg_path = exec_script(gnb_pkgload,
                           [
                             target_name,
                             "--pkgsrc",
                             gnb_pkgs_dir,
                           ],
                           "string")

    public_deps = []
    if (defined(invoker.deps)) {
      foreach(dep, invoker.deps) {
        public_deps += [ "${pkg_path}/:${dep}" ]
      }
    } else {
      public_deps += [ "${pkg_path}/:default" ]
    }

    public_configs = []
    if (defined(invoker.configs)) {
      foreach(cfg, invoker.configs) {
        public_configs += [ "${pkg_path}/:${cfg}" ]
      }
    }
  }
}
