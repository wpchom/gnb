declare_args() {
  mbedtls_pkgver = "latest"

  # config
  mbedtls_config_file = ""
  tf_psa_crypto_config_file = ""
}

declare_args() {
  mbedtls_pkgdir = exec_script(gnb_pkgload,
                               [
                                 "--download",
                                 "mbedtls:${mbedtls_pkgver}",
                                 "--pkgsrc",
                                 gnb_pkgs_dir,
                               ],
                               "string")
}

declare_args() {
  tf_psa_crypto_pkgdir = "${mbedtls_pkgdir}/tf-psa-crypto"
}

declare_toolchain(profile_toolchain) {
}

config("tf_psa_crypto_cfg") {
  include_dirs = [
    "${tf_psa_crypto_pkgdir}/include",
    "${tf_psa_crypto_pkgdir}/drivers/builtin/include",
  ]

  if (defined(tf_psa_crypto_config_file) && tf_psa_crypto_config_file != "") {
    defines = [ "TF_PSA_CRYPTO_CONFIG_FILE=\"${tf_psa_crypto_config_file}\"" ]
  }
}

