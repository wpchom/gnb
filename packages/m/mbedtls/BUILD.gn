static_library("tf_psa_crypto") {
  sources = [
    "${tf_psa_crypto_pkgdir}/core/psa_crypto.c",
    "${tf_psa_crypto_pkgdir}/core/psa_crypto_client.c",
    "${tf_psa_crypto_pkgdir}/core/psa_crypto_driver_wrappers_no_static.c",
    "${tf_psa_crypto_pkgdir}/core/psa_crypto_slot_management.c",
    "${tf_psa_crypto_pkgdir}/core/psa_crypto_storage.c",
    "${tf_psa_crypto_pkgdir}/core/psa_its_file.c",
    "${tf_psa_crypto_pkgdir}/core/tf_psa_crypto_config.c",
    "${tf_psa_crypto_pkgdir}/core/tf_psa_crypto_version.c",
  ]

  include_dirs = [
    "${tf_psa_crypto_pkgdir}/core/",
    "${tf_psa_crypto_pkgdir}/drivers/builtin/src",
  ]

  deps = [ ":tf_psa_crypto_builtin" ]

  public_configs = [ ":tf_psa_crypto_cfg" ]
}

config("mbedtls_cfg") {
  include_dirs = [ "${mbedtls_pkgdir}/include" ]

  if (defined(mbedtls_config_file) && mbedtls_config_file != "") {
    defines = [ "MBEDTLS_CONFIG_FILE=\"${mbedtls_config_file}\"" ]
  }
}

static_library("mbedx509") {
  sources = [
    "${mbedtls_pkgdir}/library/error.c",
    "${mbedtls_pkgdir}/library/mbedtls_config.c",
    "${mbedtls_pkgdir}/library/pkcs7.c",
    "${mbedtls_pkgdir}/library/x509.c",
    "${mbedtls_pkgdir}/library/x509_create.c",
    "${mbedtls_pkgdir}/library/x509_crl.c",
    "${mbedtls_pkgdir}/library/x509_crt.c",
    "${mbedtls_pkgdir}/library/x509_csr.c",
    "${mbedtls_pkgdir}/library/x509_oid.c",
    "${mbedtls_pkgdir}/library/x509write.c",
    "${mbedtls_pkgdir}/library/x509write_crt.c",
    "${mbedtls_pkgdir}/library/x509write_csr.c",
  ]

  include_dirs = [
    "${mbedtls_pkgdir}/library",
    "${tf_psa_crypto_pkgdir}/core/",
    "${tf_psa_crypto_pkgdir}/drivers/builtin/src",
  ]

  public_deps = [ ":tf_psa_crypto" ]

  public_configs = [ ":mbedtls_cfg" ]
}

