declare_args() {
  mds_pkgver = ""
  mds_pkgsrc = ""
}

if (mds_pkgsrc != "") {
  mds_pkgdir = mds_pkgsrc
} else {
  mds_pkgret = exec_script(gnb_pkgload,
                           [
                             "mds:${mds_pkgver}",
                             "--pkgs_dir",
                             gnb_pkgs_dir,
                           ],
                           "string")
  mds_pkgret = string_split(mds_pkgret, ":")
  mds_pkgver = mds_pkgret[0]
  mds_pkgdir = mds_pkgret[1]
}

declare_toolchain(profile_toolchain) {
}

group("default") {
  public_deps = [ "${mds_pkgdir}/:mds" ]
}
