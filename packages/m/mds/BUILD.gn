declare_args() {
  mds_pkgver = ""
  mds_pkgsrc = ""

  mds_pkgcfg = {
    cfgfile = ""
  }
}

if (mds_pkgsrc != "") {
  mds_pkgdir = mds_pkgsrc
} else {
  mds_pkgdir = exec_script(gnb_pkgload,
                           [
                             "mds",
                             "--version",
                             mds_pkgver,
                             "--pkgs_dir",
                             gnb_pkgs_dir,
                           ],
                           "string")
}

declare_toolchain(profile_toolchain) {
}

group("kernel") {
  public_deps = [ "${mds_pkgdir}/:kernel" ]
}

group("device") {
  public_deps = [ "${mds_pkgdir}/:device" ]
}

group("components") {
  public_deps = [ "${mds_pkgdir}/:components" ]
}

group("default") {
  public_deps = [
    ":components",
    ":device",
    ":kernel",
  ]
}
