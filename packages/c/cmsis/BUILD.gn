declare_args() {
  cmsis_pkgver = ""
  cmsis_pkgsrc = ""
}

if (cmsis_pkgsrc != "") {
  cmsis_pkgdir = cmsis_pkgsrc
} else {
  cmsis_pkgret = exec_script(gnb_pkgload,
                             [
                               "cmsis:${cmsis_pkgver}",
                               "--pkgs_dir",
                               gnb_pkgs_dir,
                             ],
                             "string")
  cmsis_pkgret = string_split(cmsis_pkgret, ":")
  cmsis_pkgver = cmsis_pkgret[0]
  cmsis_pkgdir = cmsis_pkgret[1]
}

declare_toolchain(profile_toolchain) {
}

config("cmsis_core") {
  include_dirs = [ "${cmsis_pkgdir}/Core/Include" ]
}

group("default") {
  public_configs = [ ":cmsis_core" ]
}

config("public") {
  configs = [ ":cmsis_core" ]
}
