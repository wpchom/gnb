declare_args() {
  cmsis_pkgver = ""
  cmsis_pkgsrc = ""

  cmsis_pkgcfg = {
  }
}

if (cmsis_pkgsrc != "") {
  cmsis_pkgdir = cmsis_pkgsrc
} else {
  cmsis_pkgdir = exec_script(gnb_pkgload,
                             [
                               "cmsis",
                               "--version",
                               cmsis_pkgver,
                               "--pkgs_dir",
                               gnb_pkgs_dir,
                             ],
                             "string")
}

declare_toolchain(profile_toolchain) {
}

config("cmsis_core") {
  include_dirs = [ "${cmsis_pkgdir}/Core/Include" ]
}

group("default") {
  public_configs = [ ":cmsis_core" ]
}
