declare_args() {
  lvgl_pkgver = ""
  lvgl_pkgsrc = ""
}

if (lvgl_pkgsrc != "") {
  lvgl_pkgdir = lvgl_pkgsrc
} else {
  lvgl_pkgret = exec_script(gnb_pkgload,
                            [
                              "lvgl:${lvgl_pkgver}",
                              "--pkgs_dir",
                              gnb_pkgs_dir,
                            ],
                            "string")
  lvgl_pkgret = string_split(lvgl_pkgret, ":")
  lvgl_pkgver = lvgl_pkgret[0]
  lvgl_pkgdir = lvgl_pkgret[1]
}

declare_args() {
  lvgl_pkgcfg = {
    confile = ""
    confdir = ""
    libnemagfx = ""
    mds = false
  }
}

declare_toolchain(profile_toolchain) {
}

config("lvgl_cfg") {
  include_dirs = [ "${lvgl_pkgdir}/src" ]

  defines = []

  if (defined(lvgl_pkgcfg.confile) && lvgl_pkgcfg.confile != "") {
    defines += [ "LV_CONF_PATH=\"${lvgl_pkgcfg.confile}\"" ]
  } else if (defined(lvgl_pkgcfg.confdir) && lvgl_pkgcfg.confdir != "") {
    defines += [ "LV_CONF_INCLUDE_SIMPLE" ]
    include_dirs += [ lvgl_pkgcfg.confdir ]
  } else {
    defines += [ "LV_CONF_INCLUDE_SIMPLE" ]
    include_dirs += [ rebase_path("./") ]
  }
}

config("lvgl_demos_cfg") {
  include_dirs = [ "${lvgl_pkgdir}/demos" ]
}

config("lvgl_examples_cfg") {
  include_dirs = [ "${lvgl_pkgdir}/examples" ]
}

group("lvgl_deps") {
  public_configs = [ ":lvgl_cfg" ]

  public_deps = []

  if (defined(lvgl_pkgcfg.mds) && lvgl_pkgcfg.mds) {
    public_deps += [ "patch/:lv_mds" ]
  }
}

