declare_args() {
  lvgl_patch_pkgcfg = {
    osal_mds = false
  }
}

if (defined(lvgl_patch_pkgcfg.osal_mds) && lvgl_patch_pkgcfg.osal_mds) {
  pkgcfgs("mds") {
  }
}

config("lvgl_patch_cfg") {
  include_dirs = [ "include/" ]
  configs = []

  if (defined(lvgl_patch_pkgcfg.osal_mds) && lvgl_patch_pkgcfg.osal_mds) {
    configs += [ ":mds" ]
  }
}

source_set("lvgl_patch") {
  sources = []
  configs = [ "../:lvgl_src_cfg" ]

  if (defined(lvgl_patch_pkgcfg.osal_mds) && lvgl_patch_pkgcfg.osal_mds) {
    sources += [ "src/osal/lv_mds.c" ]
  }

  public_configs = [ ":lvgl_patch_cfg" ]
}
