declare_args() {
  lzma_pkgver = ""
  lzma_pkgsrc = ""
}

if (lzma_pkgsrc != "") {
  lzma_pkgdir = lzma_pkgsrc
} else {
  lzma_pkgret = exec_script(gnb_pkgload,
                            [
                              "lzma:${lzma_pkgver}",
                              "--pkgs_dir",
                              gnb_pkgs_dir,
                            ],
                            "string")
  lzma_pkgret = string_split(lzma_pkgret, ":")
  lzma_pkgver = lzma_pkgret[0]
  lzma_pkgdir = lzma_pkgret[1]
}

declare_args() {
  lzma_pkgcfg = {
    size_opt = true
    prob32 = false
  }
}

declare_toolchain(profile_toolchain) {
}

config("lzma_cfg") {
  include_dirs = [ "${lzma_pkgdir}/C" ]

  defines = []
  if (defined(lzma_pkgcfg.size_opt) && lzma_pkgcfg.size_opt) {
    defines += [ "Z7_LZMA_SIZE_OPT=1" ]
  }
  if (defined(lzma_pkgcfg.prob32) && lzma_pkgcfg.prob32) {
    defines += [ "Z7_LZMA_PROB32=1" ]
  }
}

