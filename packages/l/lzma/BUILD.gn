    "${lzma_pkgdir}/C/Bra86.c",
    "${lzma_pkgdir}/C/BraIA64.c",
    "${lzma_pkgdir}/C/CpuArch.c",
    "${lzma_pkgdir}/C/Delta.c",
    "${lzma_pkgdir}/C/DllSecur.c",
    "${lzma_pkgdir}/C/LzFind.c",
    "${lzma_pkgdir}/C/LzFindMt.c",
    "${lzma_pkgdir}/C/LzFindOpt.c",
    "${lzma_pkgdir}/C/Lzma2Dec.c",
    "${lzma_pkgdir}/C/Lzma2DecMt.c",
    "${lzma_pkgdir}/C/Lzma2Enc.c",
