    "${lzma_pkgdir}/C/7zStream.c",
    "${lzma_pkgdir}/C/Aes.c",
    "${lzma_pkgdir}/C/AesOpt.c",
    "${lzma_pkgdir}/C/Alloc.c",
    "${lzma_pkgdir}/C/Bcj2.c",
