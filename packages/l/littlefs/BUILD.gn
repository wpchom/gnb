declare_args() {
  littlefs_pkgver = ""
  littlefs_pkgsrc = ""

  littlefs_pkgcfg = {
    cfgfile = ""

    max_name_size = 255
    max_file_size = 2147483647
    max_attr_size = 1022

    readonly_enable = false
    migrate_enable = false
  }
}

if (littlefs_pkgsrc != "") {
  littlefs_pkgdir = littlefs_pkgsrc
} else {
  littlefs_pkgdir = exec_script(gnb_pkgload,
                                [
                                  "littlefs",
                                  "--version",
                                  littlefs_pkgver,
                                  "--pkgs_dir",
                                  gnb_pkgs_dir,
                                ],
                                "string")
}

declare_toolchain(profile_toolchain) {
}

config("littlefs_cfg") {
  include_dirs = [ "${littlefs_pkgdir}" ]

  defines = [
    "LFS_NO_DEBUG=1",
    "LFS_NO_WARN=1",
    "LFS_NO_ERROR=1",
    "LFS_NAME_MAX=${littlefs_pkgcfg.max_name_size}",
    "LFS_FILE_MAX=${littlefs_pkgcfg.max_file_size}",
    "LFS_ATTR_MAX=${littlefs_pkgcfg.max_attr_size}",
  ]

  if (defined(littlefs_readonly_enable) && littlefs_readonly_enable) {
    defines += [ "LFS_READONLY=1" ]
  }

  if (defined(littlefs_migrate_enable) && littlefs_migrate_enable) {
    defines += [ "LFS_MIGRATE=1" ]
  }

  if (defined(littlefs_pkgcfg.cfgfile)) {
    defines += [ "LFS_CONFIG=\"${littlefs_pkgcfg.cfgfile}\"" ]
  }
}

static_library("littlefs") {
  sources = [
    "${littlefs_pkgdir}/lfs.c",
    "${littlefs_pkgdir}/lfs_util.c",
  ]

  include_dirs = [ "${littlefs_pkgdir}" ]

  public_configs = [ ":littlefs_cfg" ]
}

group("default") {
  public_deps = [ ":littlefs" ]
}
