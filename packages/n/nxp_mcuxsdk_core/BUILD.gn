declare_args() {
  nxp_mcuxsdk_core_pkgver = ""
  nxp_mcuxsdk_core_pkgsrc = ""

  nxp_mcuxsdk_core_pkgcfg = {
    # board_path
  }
}

if (nxp_mcuxsdk_core_pkgsrc != "") {
  nxp_mcuxsdk_core_pkgdir = nxp_mcuxsdk_core_pkgsrc
} else {
  nxp_mcuxsdk_core_pkgdir = exec_script(gnb_pkgload,
                                        [
                                          "nxp_mcuxsdk_core",
                                          "--version",
                                          nxp_mcuxsdk_core_pkgver,
                                          "--pkgs_dir",
                                          gnb_pkgs_dir,
                                        ],
                                        "string")
}

config("nxp_mcuxsdk_core_cfg") {
  include_dirs = [ "${nxp_mcuxsdk_core_pkgdir}/drivers/common" ]

  if (defined(nxp_mcuxsdk_core_pkgcfg.board_path)) {
    include_dirs += [ "${nxp_mcuxsdk_core_pkgcfg.board_path}" ]
  }
}

static_library("nxp_mcuxsdk_core") {
  sources = []

  public_configs = [ ":nxp_mcuxsdk_core_cfg" ]
}

group("default") {
  public_deps = [ ":nxp_mcuxsdk_core" ]
}
