declare_args() {
  nxp_mcux_devices_rt_pkgver = ""
  nxp_mcux_devices_rt_pkgsrc = ""

  nxp_mcux_devices_rt_pkgcfg = {
    device_ser = "RT1170"
    device_sub = "MIMXRT1176"
    device_def = "CPU_MIMXRT1176DVMAA_cm7"
  }
}

if (nxp_mcux_devices_rt_pkgsrc != "") {
  nxp_mcux_devices_rt_pkgdir = nxp_mcux_devices_rt_pkgsrc
} else {
  nxp_mcux_devices_rt_pkgdir = exec_script(gnb_pkgload,
                                           [
                                             "nxp_mcux_devices_rt",
                                             "--version",
                                             nxp_mcux_devices_rt_pkgver,
                                             "--pkgs_dir",
                                             gnb_pkgs_dir,
                                           ],
                                           "string")
}

pkggroup("cmsis") {
  configs = [ "cmsis_core" ]
}

pkggroup("nxp_mcuxsdk_core") {
  configs = [ "nxp_mcuxsdk_core_cfg" ]
}

config("nxp_mcux_devices_rt_cfg") {
  include_dirs = [
    "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}",
    "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers",
    "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/periph",
  ]

  if (nxp_mcux_devices_rt_pkgcfg.device_sub == "MIMXRT1176") {
    include_dirs += [
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/anatop_ai",
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/flexram",
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/memory",
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/nic301",
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/power",
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/romapi",
    ]
  } else {
  }

  defines = [ "${nxp_mcux_devices_rt_pkgcfg.device_def}" ]
}

source_set("nxp_mcux_devices_rt_cm7") {
  sources = [
    "${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/startup_${nxp_mcux_devices_rt_pkgcfg.device_sub}_cm7.c",
    "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/system_${nxp_mcux_devices_rt_pkgcfg.device_sub}_cm7.c",
  ]

  if (nxp_mcux_devices_rt_pkgcfg.device_sub == "MIMXRT1176") {
    sources += [
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/fsl_clock.c",
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/fsl_soc_mipi_csi2rx.c",

      # anatop_ai
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/anatop_ai/fsl_anatop_ai.c",

      # flexram
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/flexram/fsl_flexram_allocate.c",

      # romapi
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/romapi/fsl_romapi.c",

      # power
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/power/fsl_dcdc.c",
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/power/fsl_gpc.c",
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/power/fsl_pgmc.c",
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/power/fsl_pmu.c",
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/drivers/power/fsl_soc_src.c",

      # xip
      "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/xip/fsl_flexspi_nor_boot.c",
    ]
  } else {
  }

  public_configs = [ ":nxp_mcux_devices_rt_cfg" ]

  public_deps = [
    ":cmsis",
    ":nxp_mcuxsdk_core",
  ]
}

source_set("nxp_mcux_devices_rt_cm4") {
  sources = [
    "${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/startup_${nxp_mcux_devices_rt_pkgcfg.device_sub}_cm4.c",
    "${nxp_mcux_devices_rt_pkgdir}/${nxp_mcux_devices_rt_pkgcfg.device_ser}/${nxp_mcux_devices_rt_pkgcfg.device_sub}/system_${nxp_mcux_devices_rt_pkgcfg.device_sub}_cm4.c",
  ]

  public_configs = [ ":nxp_mcux_devices_rt_cfg" ]

  public_deps = [ ":cmsis" ]
}
