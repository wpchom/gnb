    "${stm32f1xx_hal_driver_pkgdir}/Src/stm32f1xx_ll_spi.c",
    "${stm32f1xx_hal_driver_pkgdir}/Src/stm32f1xx_ll_tim.c",
    "${stm32f1xx_hal_driver_pkgdir}/Src/stm32f1xx_ll_usart.c",
