declare_args() {
  drv_chip_gd32e11x_pkgver = ""
  drv_chip_gd32e11x_pkgsrc = ""
}

if (drv_chip_gd32e11x_pkgsrc != "") {
  drv_chip_gd32e11x_pkgdir = drv_chip_gd32e11x_pkgsrc
} else {
  drv_chip_gd32e11x_pkgdir = exec_script(gnb_pkgload,
                                         [
                                           "drv_chip_gd32e11x",
                                           "--version",
                                           drv_chip_gd32e11x_pkgver,
                                           "--pkgs_dir",
                                           gnb_pkgs_dir,
                                         ],
                                         "string")
}

group("default") {
  public_deps = [ "${drv_chip_gd32e11x_pkgdir}/:drv_chip_gd32e11x" ]
}
