declare_args() {
  demo_lib_pkgver = "local"
}

declare_toolchain(profile_toolchain) {
}

config("demo_lib_cfg") {
  include_dirs = [ "include" ]
}

static_library("demo_lib") {
  sources = [ "src/demo_lib.c" ]

  public_configs = [ ":demo_lib_cfg" ]
}

group("default") {
  public_deps = [ ":demo_lib" ]
}
