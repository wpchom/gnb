declare_args() {
  drv_chip_gd32h7xx_pkgver = ""
  drv_chip_gd32h7xx_pkgsrc = ""
}

if (drv_chip_gd32h7xx_pkgsrc != "") {
  drv_chip_gd32h7xx_pkgdir = drv_chip_gd32h7xx_pkgsrc
} else {
  drv_chip_gd32h7xx_pkgdir = exec_script(gnb_pkgload,
                                         [
                                           "drv_chip_gd32h7xx",
                                           "--version",
                                           drv_chip_gd32h7xx_pkgver,
                                           "--pkgs_dir",
                                           gnb_pkgs_dir,
                                         ],
                                         "string")
}

group("default") {
  public_deps = [ "${drv_chip_gd32h7xx_pkgdir}/:drv_chip_gd32h7xx" ]
}
