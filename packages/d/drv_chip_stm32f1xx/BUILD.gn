declare_args() {
  drv_chip_stm32f1xx_pkgver = "latest"
  drv_chip_stm32f1xx_pkgpth = ""
}

declare_args() {
  if (drv_chip_stm32f1xx_pkgpth == "") {
    drv_chip_stm32f1xx_pkgdir =
        exec_script(gnb_pkgload,
                    [
                      "--download",
                      "drv_chip_stm32f1xx:${drv_chip_stm32f1xx_pkgver}",
                      "--pkgsrc",
                      gnb_pkgs_dir,
                    ],
                    "string")
  } else {
    drv_chip_stm32f1xx_pkgdir = drv_chip_stm32f1xx_pkgpth
  }
}

declare_toolchain(profile_toolchain) {
}

group("default") {
  public_deps = [ "${drv_chip_stm32f1xx_pkgdir}/:drv_chip_stm32f1xx" ]
}
