declare_args() {
  gd32e11x_firmware_pkgver = ""
  gd32e11x_firmware_pkgsrc = ""
}

if (gd32e11x_firmware_pkgsrc != "") {
  gd32e11x_firmware_pkgdir = gd32e11x_firmware_pkgsrc
} else {
  gd32e11x_firmware_pkgdir = exec_script(gnb_pkgload,
                                         [
                                           "gd32e11x_firmware",
                                           "--version",
                                           gd32e11x_firmware_pkgver,
                                           "--pkgs_dir",
                                           gnb_pkgs_dir,
                                         ],
                                         "string")
}

declare_args() {
  gd32e11x_firmware_pkgcfg = {
    hxtal_value = 8000000
    system_clock = "__SYSTEM_CLOCK_IRC8M"
  }
}

pkggroup("cmsis") {
  configs = [ "cmsis_core" ]
}

config("gd32e11x_firmware_cfg") {
  include_dirs = [
    "${gd32e11x_firmware_pkgdir}/CMSIS/GD/GD32E11x/Include",
    "${gd32e11x_firmware_pkgdir}/GD32E11x_standard_peripheral/Include",
    "include",
  ]

  defines = [ "GD32E11X" ]

  if (defined(gd32e11x_firmware_pkgcfg.hxtal_value)) {
    defines += [ "HXTAL_VALUE=${gd32e11x_firmware_pkgcfg.hxtal_value}" ]
  }
}

static_library("gd32e11x_firmware") {
  sources = [
    "${gd32e11x_firmware_pkgdir}/CMSIS/GD/GD32E11x/Source/system_gd32e11x.c",
    "src/gd32e11x_redirect.c",
  ]

  defines = []

  if (defined(gd32e11x_firmware_pkgcfg.system_clock)) {
    defines += [ "${gd32e11x_firmware_pkgcfg.system_clock}" ]
  }

  public_configs = [ ":gd32e11x_firmware_cfg" ]

  public_deps = [ ":cmsis" ]
}

group("default") {
  public_deps = [ ":gd32e11x_firmware" ]
}
