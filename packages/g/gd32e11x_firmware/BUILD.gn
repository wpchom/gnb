declare_args() {
  gd32e11x_firmware_pkgver = "latest"

  # config
  gd32e11x_hxtal_value = 8000000
  gd32e11x_system_clock = "__SYSTEM_CLOCK_IRC8M"
}

declare_args() {
  gd32e11x_firmware_pkgdir =
      exec_script(gnb_pkgload,
                  [
                    "--download",
                    "gd32e11x_firmware:${gd32e11x_firmware_pkgver}",
                    "--pkgsrc",
                    gnb_pkgs_dir,
                  ],
                  "string")
}

pkggroup("cmsis") {
  configs = [ "cmsis_core" ]
}

config("gd32e11x_firmware_cfg") {
  include_dirs = [
    "${gd32e11x_firmware_pkgdir}/CMSIS/GD/GD32E11x/Include",
    "${gd32e11x_firmware_pkgdir}/GD32E11x_standard_peripheral/Include",
    "include",
  ]

  defines = [ "GD32E11X" ]

  if (defined(gd32e11x_hxtal_value) && gd32e11x_hxtal_value > 0) {
    defines += [ "HXTAL_VALUE=${gd32e11x_hxtal_value}" ]
  }
}

static_library("gd32e11x_firmware") {
  sources = [
    "${gd32e11x_firmware_pkgdir}/CMSIS/GD/GD32E11x/Source/system_gd32e11x.c",
    "src/gd32e11x_redirect.c",
  ]

  defines = []

  if (defined(gd32e11x_system_clock) && gd32e11x_system_clock != "") {
    defines += [ "${gd32e11x_system_clock}" ]
  }

  public_configs = [ ":gd32e11x_firmware_cfg" ]

  public_deps = [ ":cmsis" ]
}

group("default") {
  public_deps = [ ":gd32e11x_firmware" ]
}
