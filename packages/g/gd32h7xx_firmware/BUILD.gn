declare_args() {
  gd32h7xx_firmware_pkgver = ""
  gd32h7xx_firmware_pkgsrc = ""

  gd32h7xx_firmware_pkgcfg = {
    hxtal_value = 25000000
    system_clock = "__SYSTEM_CLOCK_IRC64M"
  }
}

if (gd32h7xx_firmware_pkgsrc != "") {
  gd32h7xx_firmware_pkgdir = gd32h7xx_firmware_pkgsrc
} else {
  gd32h7xx_firmware_pkgdir = exec_script(gnb_pkgload,
                                         [
                                           "gd32h7xx_firmware",
                                           "--version",
                                           gd32h7xx_firmware_pkgver,
                                           "--pkgs_dir",
                                           gnb_pkgs_dir,
                                         ],
                                         "string")
}

pkggroup("cmsis") {
  configs = [ "cmsis_core" ]
}

config("gd32h7xx_firmware_cfg") {
  include_dirs = [
    "${gd32h7xx_firmware_pkgdir}/CMSIS/GD/GD32H7xx/Include",
    "${gd32h7xx_firmware_pkgdir}/GD32H7xx_standard_peripheral/Include",
    "include",
  ]

  defines = [ "GD32H7XX" ]

  if (defined(gd32h7xx_firmware_pkgcfg.hxtal_value)) {
    defines += [ "HXTAL_VALUE=${gd32h7xx_firmware_pkgcfg.hxtal_value}" ]
  }
}

static_library("gd32h7xx_firmware") {
  sources = [
    "${gd32h7xx_firmware_pkgdir}/CMSIS/GD/GD32H7xx/Source/system_gd32h7xx.c",
    "src/gd32h7xx_redirect.c",
  ]

  defines = []

  if (defined(gd32h7xx_firmware_pkgcfg.system_clock)) {
    defines += [ "${gd32h7xx_firmware_pkgcfg.system_clock}" ]
  }

  public_configs = [ ":gd32h7xx_firmware_cfg" ]

  public_deps = [ ":cmsis" ]
}

group("default") {
  public_deps = [ ":gd32h7xx_firmware" ]
}
